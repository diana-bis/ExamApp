{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Express Server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/server/src/index.js",
            "console": "integratedTerminal"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug React Client (Chrome)",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/client"
        }
    ],
    "compounds": [
        {
            "name": "Debug Full Stack (Server + Client)",
            "configurations": [
                "Debug Express Server",
                "Debug React Client (Chrome)"
            ]
        }
    ]
}